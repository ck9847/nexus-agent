    {
      "id": 17,
      "type": "timeseries",
      "title": "JVM heap/non-heap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
