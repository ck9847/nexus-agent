        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_model_call_seconds_bucket{instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "工具执行 outcome（registered/replayed/succeeded/failed/conflict）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": {
