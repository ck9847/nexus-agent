      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_conversation_turn_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "模型调用成功/失败",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" }
