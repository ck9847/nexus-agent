      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (error_category) (rate(nexus_model_call_seconds_count{outcome=\"failure\", instance=~\"$instance\", provider=~\"$provider\", error_category=~\"$error_category\"}[$__rate_interval]))",
          "legendFormat": "{{error_category}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "模型 P95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
