# ---- MySQL ----
MYSQL_DATABASE=nexus_agent
MYSQL_USER=nexus_app
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_ROOT_PASSWORD=replace_with_strong_password
MYSQL_PORT=3307

# ---- 应用对外端口（容器内固定为 8080） ----
SERVER_PORT=8080

# ---- JWT ----
# NEXUS_JWT_SECRET 必须是 Base64 编码，且解码后不少于 32 字节。
# 生成命令（PowerShell）：
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
NEXUS_JWT_SECRET=replace_with_base64_encoded_32_byte_secret
NEXUS_JWT_ISSUER=https://auth.nexus-agent.local
NEXUS_JWT_ACCESS_TOKEN_TTL=15m

# ---- OpenAI 模型网关（默认关闭） ----
NEXUS_OPENAI_ENABLED=false
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
NEXUS_OPENAI_CONNECT_TIMEOUT=10s
NEXUS_OPENAI_READ_TIMEOUT=2m
NEXUS_OPENAI_MAX_ERROR_BODY_BYTES=8192

# ---- 会话流式线程池与超时 ----
NEXUS_CONVERSATION_STREAM_TIMEOUT=2m
NEXUS_CONVERSATION_STREAM_CORE_POOL_SIZE=4
NEXUS_CONVERSATION_STREAM_MAX_POOL_SIZE=16
NEXUS_CONVERSATION_STREAM_QUEUE_CAPACITY=100

# ---- 可选：ID 节点与密码哈希强度 ----
NEXUS_ID_NODE_ID=0
NEXUS_BCRYPT_STRENGTH=12
